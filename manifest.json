{
  "manifest_version": 3,
  "name": "LingoSprout — Contextual Language Learning",
  "short_name": "LingoSprout",
  "version": "1.0.0",
  "description": "Read, respond and review. A presentation prototype for contextual language learning with explicit page activation.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "src/background.js"},
  "icons": {"16":"assets/icon-16.png","32":"assets/icon-32.png","48":"assets/icon-48.png","128":"assets/icon-128.png"},
  "action": {"default_title":"LingoSprout","default_popup":"src/popup.html","default_icon":{"16":"assets/icon-16.png","32":"assets/icon-32.png"}},
  "options_page": "src/dashboard.html"
}
